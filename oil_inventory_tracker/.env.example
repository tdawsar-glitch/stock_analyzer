# Vortexa API key — request one from your Vortexa account manager
VORTEXA_API_KEY=

# Optional: EIA API key for US crude reconciliation widget
# Request at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Admin token for /api/refresh (set to a long random string in production)
ADMIN_TOKEN=

# Cache database path (relative to backend cwd)
CACHE_DB_PATH=./data/inventory_cache.duckdb

# Daily refresh schedule (cron-style, UTC)
REFRESH_CRON=15 6 * * *

# Set to 1 to serve synthetic data without calling Vortexa.
# Useful for local UI development before your IP is on Vortexa's allowlist.
OIT_DEMO_MODE=0
